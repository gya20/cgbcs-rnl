simulator lang=spectre
// @RNL(type="header") { @VERSION("0.3"); @USE-PACKAGE(name="cgbcs-pvr", version="1.0", path="../symbols.rnl") }

subckt L3_TM_COMMON_CARD_PCB (buf card plug g)
parameters ccard=100u ratiosq=18.29 lenmm=27.5 cum=35 rreturn=5m lmm=0.5n cmm=0.12p rcontact=10m lcontact=1n rneck=2m lneck=1n lcap=0.7n esr=10m
Rsense (buf after10) L5_TM_COMMON_RES r=10
Xneck (after10 card g) L4_TM_COMMON_LINE rs=rneck le=lneck
Ccard (card g) L5_TM_COMMON_CAP c=ccard esr=esr esl=lcap
Xs1 (card n1 g) L4_TM_COMMON_PI_SECTION rr=(0.01724*ratiosq/cum+rreturn)/4 ll=lmm*lenmm/4 cc=cmm*lenmm/4
Xs2 (n1 n2 g) L4_TM_COMMON_PI_SECTION rr=(0.01724*ratiosq/cum+rreturn)/4 ll=lmm*lenmm/4 cc=cmm*lenmm/4
Xs3 (n2 n3 g) L4_TM_COMMON_PI_SECTION rr=(0.01724*ratiosq/cum+rreturn)/4 ll=lmm*lenmm/4 cc=cmm*lenmm/4
Xs4 (n3 pin g) L4_TM_COMMON_PI_SECTION rr=(0.01724*ratiosq/cum+rreturn)/4 ll=lmm*lenmm/4 cc=cmm*lenmm/4
Xcontact (pin plug g) L4_TM_COMMON_LINE rs=rcontact le=lcontact
