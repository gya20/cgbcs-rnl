simulator lang=spectre
// @RNL(type="header") { @VERSION("0.3"); @USE-PACKAGE(name="cgbcs-pvr", version="1.0", path="../symbols.rnl") }

subckt L5_TM_COMMON_CAP (a b)
parameters c=100n kc=1 np=1 esr=30m esl=0.25n rleak=1T daf=0 rda=10M
Resr (a t) resistor r=esr/np
Gs (b h t store) vccs gm=0.1
Cx (h b) capacitor c=esl*0.01/np
Rx (h b) resistor r=1T isnoisy=no
Gi (t store h b) vccs gm=0.1
Cstore (store b) capacitor c=c*kc*np
Rleak (store b) resistor r=rleak/np
Rda (store da) resistor r=rda/np
Cda (da b) capacitor c=c*kc*np*daf
