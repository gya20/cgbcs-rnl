simulator lang=spectre
// @RNL(type="header") { @VERSION("0.3"); @USE-PACKAGE(name="cgbcs-pvr", version="1.0", path="../../symbols.rnl") }
subckt TM_PVR_LT3042 (set out bias g)
parameters ereg=2.53n freg=1M rreg=50m vos=0
Xn (u set g) TM_PVR_NOISE ew=ereg
Ecmd (v g u g) vcvs gain=1
Eoff (w v bias g) vcvs gain=vos
Rf (w x) resistor r=1k isnoisy=no
Cf (x g) capacitor c=1/(6.283185307*1k*freg)
Edrive (b g x g) vcvs gain=1
Rreg (b out) resistor r=rreg isnoisy=no
