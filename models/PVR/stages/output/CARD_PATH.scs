simulator lang=spectre
// @RNL(type="header") { @VERSION("0.3"); @USE-PACKAGE(name="cgbcs-pvr", version="1.0", path="../../symbols.rnl") }
subckt TM_PVR_CARD_PATH (plug pad die g)
parameters cpad=11.1u
Xfeed (plug pad g) TM_PVR_LINE rs=20m le=1n
Cboard (pad g) capacitor c=cpad
Xbond (pad die g) TM_PVR_LINE rs=50m le=2n
