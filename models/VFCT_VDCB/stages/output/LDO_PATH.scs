simulator lang=spectre
// @RNL(type="header") { @VERSION("0.3"); @USE-PACKAGE(name="cgbcs-vfct-vdcb", version="1.0", path="../../symbols.rnl") }
subckt TM_LDO_LDO_PATH (out pad die g)
Xnear (out g) TM_LDO_DECOUPLE
Xfeed (out pad g) TM_LDO_LINE rs=20m le=1n
Xpad (pad g) TM_LDO_DECOUPLE
Xbond (pad die g) TM_LDO_LINE rs=50m le=2n
