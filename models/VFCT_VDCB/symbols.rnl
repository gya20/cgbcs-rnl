@RNL(type="header") {
  @VERSION("0.3");
  @PACKAGE(name="cgbcs-vfct-vdcb", version="1.0");
  @USE-PACKAGE(name="rnl-std-full", version="0.3");
  @DEVICE(name="*", model="resistor", terminals=["p", "n"]);
  @DEVICE(name="*", model="capacitor", terminals=["p", "n"]);
  @DEVICE(name="*", model="vcvs", terminals=["op", "on", "cp", "cn"]);
  @DEVICE(name="*", model="vccs", terminals=["op", "on", "cp", "cn"]);
  @DEVICE(name="*", model="L0_TM_LDO_LDO", terminals=["vin", "bias", "outcb", "padcb", "diecb", "outfct", "padfct", "diefct", "g"]);
  @DEVICE(name="*", model="L1_TM_LDO_LDO_CH", terminals=["vin", "bias", "out", "pad", "die", "g", "setret"]);
  @DEVICE(name="*", model="L2_TM_LDO_LT3042", terminals=["vin", "set", "out", "bias", "g"]);
  @DEVICE(name="*", model="L5_TM_COMMON_RES", terminals=["a", "b"]);
  @DEVICE(name="*", model="L5_TM_COMMON_CAP", terminals=["a", "b"]);
  @DEVICE(name="*", model="L4_TM_COMMON_NOISE", terminals=["p", "q", "g"]);
  @DEVICE(name="*", model="L4_TM_COMMON_LINE", terminals=["a", "b", "g"])
}
@RNL {
  $SYM_RESISTOR = @DEFINE-SYMBOL(box=[-3,-2,3,2]) {
    @LINE {(-3, 0) (-1.7, 0) (-1.4, 0.55) (-0.9, -0.55) (-0.45, 0.55) (0, -0.55) (0.45, 0.55) (0.9, -0.55) (1.4, 0.55) (1.7, 0) (3, 0)};
    (-3, 0) @PIN(terminal=1, direction="left");
    (3, 0) @PIN(terminal=2, direction="right")
  };
  # @SELECT-INSTANCE(model="resistor") => @SET-SYMBOL $SYM_RESISTOR;
  $SYM_CAPACITOR = @DEFINE-SYMBOL(box=[-3,-2,3,2]) {
    @LINE {(-3, 0) (-0.28, 0)};
    @LINE {(0.28, 0) (3, 0)};
    @LINE {(-0.28, -1) (-0.28, 1)};
    @LINE {(0.28, -1) (0.28, 1)};
    (-3, 0) @PIN(terminal=1, direction="left");
    (3, 0) @PIN(terminal=2, direction="right")
  };
  # @SELECT-INSTANCE(model="capacitor") => @SET-SYMBOL $SYM_CAPACITOR;
  $SYM_VCVS = @DEFINE-SYMBOL(box=[-4,-3,4,3]) {
    @LINE {(0, 2) (2, 0) (0, -2) (-2, 0) (0, 2)};
    @LINE {(0, 3) (0, 2)};
    @LINE {(0, -2) (0, -3)};
    @LINE {(-4, 1) (-2.8, 1)};
    @LINE {(-4, -1) (-2.8, -1)};
    (-2.6, 1) @TEXT("+", size=0.8, halign="middle", valign="middle");
    (-2.6, -1) @TEXT("−", size=0.8, halign="middle", valign="middle");
    (0, 0.8) @TEXT("+", size=1, halign="middle", valign="middle");
    (0, -0.8) @TEXT("−", size=1, halign="middle", valign="middle");
    (0, 3) @PIN(terminal=1, direction="up");
    (0, -3) @PIN(terminal=2, direction="down");
    (-4, 1) @PIN(terminal=3, direction="left");
    (-4, -1) @PIN(terminal=4, direction="left")
  };
  # @SELECT-INSTANCE(model="vcvs") => @SET-SYMBOL $SYM_VCVS;
  $SYM_VCCS = @DEFINE-SYMBOL(box=[-4,-3,4,3]) {
    @LINE {(0, 2) (2, 0) (0, -2) (-2, 0) (0, 2)};
    @LINE {(0, 3) (0, 2)};
    @LINE {(0, -2) (0, -3)};
    @LINE {(-4, 1) (-2.8, 1)};
    @LINE {(-4, -1) (-2.8, -1)};
    (-2.6, 1) @TEXT("+", size=0.8, halign="middle", valign="middle");
    (-2.6, -1) @TEXT("−", size=0.8, halign="middle", valign="middle");
    @LINE {(0, 0.95) (0, -0.95)};
    @LINE {(-0.35, -0.4) (0, -0.95) (0.35, -0.4)};
    (0, 3) @PIN(terminal=1, direction="up");
    (0, -3) @PIN(terminal=2, direction="down");
    (-4, 1) @PIN(terminal=3, direction="left");
    (-4, -1) @PIN(terminal=4, direction="left")
  };
  # @SELECT-INSTANCE(model="vccs") => @SET-SYMBOL $SYM_VCCS;
  $SYM_L0_TM_LDO_LDO = @DEFINE-SYMBOL(box=[-15,-14,15,14]) {
    @LINE {(-14, -13) (14, -13) (14, 13) (-14, 13) (-14, -13)};
    @LINE {(-15, 0) (-14, 0)};
    (-13.5, 0) @TEXT("vin", size=0.74, halign="start", valign="middle");
    @LINE {(-5, -14) (-5, -13)};
    (-5, -12.3) @TEXT("bias", size=0.74, halign="middle", valign="middle");
    @LINE {(15, 10) (14, 10)};
    (13.5, 10) @TEXT("outcb", size=0.74, halign="end", valign="middle");
    @LINE {(15, 6) (14, 6)};
    (13.5, 6) @TEXT("padcb", size=0.74, halign="end", valign="middle");
    @LINE {(15, 2) (14, 2)};
    (13.5, 2) @TEXT("diecb", size=0.74, halign="end", valign="middle");
    @LINE {(15, -2) (14, -2)};
    (13.5, -2) @TEXT("outfct", size=0.74, halign="end", valign="middle");
    @LINE {(15, -6) (14, -6)};
    (13.5, -6) @TEXT("padfct", size=0.74, halign="end", valign="middle");
    @LINE {(15, -10) (14, -10)};
    (13.5, -10) @TEXT("diefct", size=0.74, halign="end", valign="middle");
    @LINE {(5, -14) (5, -13)};
    (5, -12.3) @TEXT("g", size=0.74, halign="middle", valign="middle");
    (0, 1) @TEXT("LDO", size=0.99, halign="middle", valign="middle");
    (-15, 0) @PIN(terminal=1, direction="left");
    (-5, -14) @PIN(terminal=2, direction="down");
    (15, 10) @PIN(terminal=3, direction="right");
    (15, 6) @PIN(terminal=4, direction="right");
    (15, 2) @PIN(terminal=5, direction="right");
    (15, -2) @PIN(terminal=6, direction="right");
    (15, -6) @PIN(terminal=7, direction="right");
    (15, -10) @PIN(terminal=8, direction="right");
    (5, -14) @PIN(terminal=9, direction="down");
    ? @TEXT("${name}", key="name", size=0.8, halign="middle", valign="bottom") => @PLACE(0, 15.35)
  };
  # @SELECT-INSTANCE(model="L0_TM_LDO_LDO") => @SET-SYMBOL $SYM_L0_TM_LDO_LDO;
  $SYM_L1_TM_LDO_LDO_CH = @DEFINE-SYMBOL(box=[-15,-8,15,8]) {
    @LINE {(-14, -7) (14, -7) (14, 7) (-14, 7) (-14, -7)};
    @LINE {(-15, 0) (-14, 0)};
    (-13.5, 0) @TEXT("vin", size=0.74, halign="start", valign="middle");
    @LINE {(-5, -8) (-5, -7)};
    (-5, -6.3) @TEXT("bias", size=0.74, halign="middle", valign="middle");
    @LINE {(15, 4) (14, 4)};
    (13.5, 4) @TEXT("out", size=0.74, halign="end", valign="middle");
    @LINE {(15, 0) (14, 0)};
    (13.5, 0) @TEXT("pad", size=0.74, halign="end", valign="middle");
    @LINE {(15, -4) (14, -4)};
    (13.5, -4) @TEXT("die", size=0.74, halign="end", valign="middle");
    @LINE {(5, -8) (5, -7)};
    (5, -6.3) @TEXT("g", size=0.74, halign="middle", valign="middle");
    @LINE {(12, -8) (12, -7)};
    (12, -6.3) @TEXT("setret", size=0.74, halign="middle", valign="middle");
    (0, 1) @TEXT("LT3042 supply", size=0.99, halign="middle", valign="middle");
    (-15, 0) @PIN(terminal=1, direction="left");
    (-5, -8) @PIN(terminal=2, direction="down");
    (15, 4) @PIN(terminal=3, direction="right");
    (15, 0) @PIN(terminal=4, direction="right");
    (15, -4) @PIN(terminal=5, direction="right");
    (5, -8) @PIN(terminal=6, direction="down");
    (12, -8) @PIN(terminal=7, direction="down");
    ? @TEXT("${name}", key="name", size=0.8, halign="middle", valign="bottom") => @PLACE(0, 9.35)
  };
  # @SELECT-INSTANCE(model="L1_TM_LDO_LDO_CH") => @SET-SYMBOL $SYM_L1_TM_LDO_LDO_CH;
  $SYM_L2_TM_LDO_LT3042 = @DEFINE-SYMBOL(box=[-10,-5,10,5]) {
    @LINE {(-9, -4) (9, -4) (9, 4) (-9, 4) (-9, -4)};
    @LINE {(-10, 1) (-9, 1)};
    (-8.5, 1) @TEXT("vin", size=0.74, halign="start", valign="middle");
    @LINE {(-10, -1) (-9, -1)};
    (-8.5, -1) @TEXT("set", size=0.74, halign="start", valign="middle");
    @LINE {(10, 0) (9, 0)};
    (8.5, 0) @TEXT("out", size=0.74, halign="end", valign="middle");
    @LINE {(-3, -5) (-3, -4)};
    (-3, -3.3) @TEXT("bias", size=0.74, halign="middle", valign="middle");
    @LINE {(3, -5) (3, -4)};
    (3, -3.3) @TEXT("g", size=0.74, halign="middle", valign="middle");
    (0, 1.5) @TEXT("LT3042", size=0.99, halign="middle", valign="middle");
    (-10, 1) @PIN(terminal=1, direction="left");
    (-10, -1) @PIN(terminal=2, direction="left");
    (10, 0) @PIN(terminal=3, direction="right");
    (-3, -5) @PIN(terminal=4, direction="down");
    (3, -5) @PIN(terminal=5, direction="down");
    ? @TEXT("${name}", key="name", size=0.8, halign="middle", valign="bottom") => @PLACE(0, 6.35)
  };
  # @SELECT-INSTANCE(model="L2_TM_LDO_LT3042") => @SET-SYMBOL $SYM_L2_TM_LDO_LT3042;
  $SYM_L5_TM_COMMON_RES = @DEFINE-SYMBOL(box=[-3,-2,3,2]) {
    @LINE {(-3, 0) (-1.7, 0) (-1.4, 0.55) (-0.9, -0.55) (-0.45, 0.55) (0, -0.55) (0.45, 0.55) (0.9, -0.55) (1.4, 0.55) (1.7, 0) (3, 0)};
    (-3, 0) @PIN(terminal=1, direction="left");
    (3, 0) @PIN(terminal=2, direction="right")
  };
  # @SELECT-INSTANCE(model="L5_TM_COMMON_RES") => @SET-SYMBOL $SYM_L5_TM_COMMON_RES;
  $SYM_L5_TM_COMMON_CAP = @DEFINE-SYMBOL(box=[-3,-2,3,2]) {
    @LINE {(-3, 0) (-0.28, 0)};
    @LINE {(0.28, 0) (3, 0)};
    @LINE {(-0.28, -1) (-0.28, 1)};
    @LINE {(0.28, -1) (0.28, 1)};
