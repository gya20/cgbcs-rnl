  # @SELECT-INSTANCE(model="L5_TM_COMMON_CAP") => @SET-SYMBOL $SYM_L5_TM_COMMON_CAP;
  $SYM_L4_TM_COMMON_NOISE = @DEFINE-SYMBOL(box=[-5,-4,5,4]) {
    (0, 0) @CIRCLE(radius=2.2);
    @LINE {(-5, 0) (-2.2, 0)};
    @LINE {(2.2, 0) (5, 0)};
    @LINE {(0, -2.2) (0, -4)};
    @LINE {(-1.55, 0) (-1.1, 0.3) (-0.75, -0.6) (-0.3, 1.05) (0.15, -0.95) (0.6, 0.55) (1, 0.05) (1.5, 0.3)};
    (-2.8, 0.8) @TEXT("−", size=0.8, halign="middle", valign="middle");
    (2.8, 0.8) @TEXT("+", size=0.8, halign="middle", valign="middle");
    (5, 0) @PIN(terminal=1, direction="right");
    (-5, 0) @PIN(terminal=2, direction="left");
    (0, -4) @PIN(terminal=3, direction="down");
    ? @TEXT("${name}", key="name", size=0.8, halign="middle", valign="bottom") => @PLACE(0, 5.35)
  };
  # @SELECT-INSTANCE(model="L4_TM_COMMON_NOISE") => @SET-SYMBOL $SYM_L4_TM_COMMON_NOISE;
  $SYM_L4_TM_COMMON_LINE = @DEFINE-SYMBOL(box=[-8,-5,8,5]) {
