@RNL(type="header") {
  @VERSION("0.3");
  @PACKAGE(name="cgbcs-vpfb-vmfb", version="1.0");
  @USE-PACKAGE(name="rnl-std-full", version="0.3");
  @DEVICE(name="*", model="resistor", terminals=["p", "n"]);
  @DEVICE(name="*", model="capacitor", terminals=["p", "n"]);
  @DEVICE(name="*", model="vcvs", terminals=["op", "on", "cp", "cn"]);
  @DEVICE(name="*", model="vccs", terminals=["op", "on", "cp", "cn"]);
  @DEVICE(name="*", model="L0_TM_REF_REF", terminals=["vin", "bias", "padp", "diep", "padm", "diem", "g"]);
  @DEVICE(name="*", model="L1_TM_REF_REF_CH", terminals=["ref", "bias", "pad", "die", "g"]);
  @DEVICE(name="*", model="L4_TM_REF_NOISE_DECADE", terminals=["p", "q", "g"]);
