simulator lang=spectre
// @RNL(type="header") { @VERSION("0.3"); @USE-PACKAGE(name="cgbcs-vpfb-vmfb", version="1.0", path="../../symbols.rnl") }

subckt L2_TM_REF_ADA4522 (p n o bias g)
parameters a0=1M fu=3.274M ro=10 ew=5.8n vos=0 f2=5.252M
Xn (pn p g) L4_TM_COMMON_NOISE ew=ew
Eos (pi pn bias g) vcvs gain=vos
Gerr (g x pi n) vccs gm=a0/1M
Rd (x g) resistor r=1M isnoisy=no
Cd (x g) capacitor c=a0/(6.283185307*1M*fu)
E1 (u g x g) vcvs gain=1
R2 (u y) resistor r=1k isnoisy=no
C2 (y g) capacitor c=1/(6.283185307*1k*f2)
Ebuf (b g y g) vcvs gain=1
Ro (b o) resistor r=ro isnoisy=no
