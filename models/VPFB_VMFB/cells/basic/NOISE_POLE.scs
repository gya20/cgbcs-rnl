simulator lang=spectre
// @RNL(type="header") { @VERSION("0.3"); @USE-PACKAGE(name="cgbcs-vpfb-vmfb", version="1.0", path="../../symbols.rnl") }
subckt TM_REF_NOISE_POLE (p q g)
parameters fj=1 en=39n fc=1
Rn (w g) resistor r=1k
Cn (w g) capacitor c=1/(6.283185307*1k*fj)
En (p q w g) vcvs gain=(en/4.07035n)*sqrt(0.366468*fc/fj)
