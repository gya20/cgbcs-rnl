@RNL(type="header") {
  @VERSION("0.3");
  @PACKAGE(name="cgbcs-pvre", version="1.0");
  @USE-PACKAGE(name="rnl-std-full", version="0.3");
  @DEVICE(name="*", model="resistor", terminals=["p", "n"]);
  @DEVICE(name="*", model="capacitor", terminals=["p", "n"]);
  @DEVICE(name="*", model="vcvs", terminals=["op", "on", "cp", "cn"]);
  @DEVICE(name="*", model="vccs", terminals=["op", "on", "cp", "cn"]);
  @DEVICE(name="*", model="TM_PVRE_PVRE", terminals=["cmop", "dac1", "dac2", "bias", "buf1", "card1", "pad1", "die1", "buf2", "card2", "pad2", "die2", "g"]);
  @DEVICE(name="*", model="TM_PVRE_CARD_CHANNEL", terminals=["cm", "dac", "bias", "buf", "card", "plug", "g"]);
  @DEVICE(name="*", model="TM_PVRE_CARD_ONLY", terminals=["cmop", "dac1", "dac2", "bias", "buf1", "card1", "plug1", "buf2", "card2", "plug2", "g"]);
  @DEVICE(name="*", model="TM_PVRE_PVRE_CH", terminals=["cm", "dac", "bias", "buf", "card", "pad", "die", "g"]);
  @DEVICE(name="*", model="TM_PVRE_AMP", terminals=["p", "n", "out", "bias", "g"]);
  @DEVICE(name="*", model="TM_PVRE_LINE", terminals=["a", "b", "g"]);
  @DEVICE(name="*", model="TM_PVRE_NOISE", terminals=["p", "q", "g"]);
  @DEVICE(name="*", model="TM_PVRE_PI_SECTION", terminals=["p", "q", "g"]);
  @DEVICE(name="*", model="TM_PVRE_LT1355", terminals=["p", "n", "o", "bias", "g"]);
  @DEVICE(name="*", model="TM_PVRE_LTC2972_SET", terminals=["code", "analog", "g"]);
  @DEVICE(name="*", model="TM_PVRE_PVRE_DRV", terminals=["cm", "dac", "bias", "buf", "g"]);
  @DEVICE(name="*", model="TM_PVRE_CARD_PATH", terminals=["plug", "pad", "die", "g"]);
  @DEVICE(name="*", model="TM_PVRE_CARD_PCB", terminals=["buf", "card", "plug", "g"])
}
