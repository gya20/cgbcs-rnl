simulator lang=spectre
// @RNL(type="header") { @VERSION("0.3"); @USE-PACKAGE(name="cgbcs-pvre", version="1.0", path="../symbols.rnl") }

subckt L5_TM_COMMON_RES (a b)
parameters r=1k dr=0 ls=0.5n cp=0.05p
Rbody (a t) resistor r=r*(1+dr)
Gs (b h t b) vccs gm=0.1
Cx (h b) capacitor c=ls*0.01
Rx (h b) resistor r=1T isnoisy=no
Gi (t b h b) vccs gm=0.1
Cpar (a b) capacitor c=cp
